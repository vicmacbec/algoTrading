# Plantilla de variables de entorno. NO poner valores reales aquí.
#
# El archivo real vive FUERA del repo y FUERA de ~/Drive (Google Drive lo
# sincroniza a la nube y conserva historial de versiones):
#
#   mkdir -p ~/.config/algotrading
#   cp .env.example ~/.config/algotrading/.env
#   chmod 600 ~/.config/algotrading/.env
#
# Se carga con python-dotenv:
#   load_dotenv(Path.home() / ".config" / "algotrading" / ".env")

# --- Binance: dos llaves separadas, ninguna con permiso de retiro ---
# Solo lectura, para research y descarga de datos.
BINANCE_API_KEY_READ=
BINANCE_API_SECRET_READ=

# Con permiso de trade (spot), para paper y producción. Con IP allowlist.
BINANCE_API_KEY_TRADE=
BINANCE_API_SECRET_TRADE=

# Testnet de spot, para la fase de paper trading.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- AWS (solo desde la fase 6) ---
# Preferir perfil de la CLI o SSO antes que llaves largas aquí.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-2

# --- Alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Entorno ---
# research | paper | live  (controla contra qué endpoint se opera)
ALGOTRADING_ENV=research
# Capital de trabajo en USDT; es un parámetro, nunca un supuesto del código.
ALGOTRADING_CAPITAL_USDT=0
