{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EscribirSnapshots",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::algotrading-vicmacbec-data/snapshots/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:*:<ACCOUNT_ID>:log-group:/aws/lambda/algotrading-snapshot:*"
    }
  ]
}
